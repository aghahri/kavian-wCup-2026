generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  phone                   String                   @unique
  avatarUrl               String?
  referralCode            String?                  @unique
  referredById            String?
  isAdmin                 Boolean                  @default(false)
  isVip                   Boolean                  @default(false)
  vipUntil                DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  predictions             Prediction[]
  tournamentMemberships   TournamentMembership[]
  tournamentPredictions   TournamentPrediction[]
  referredBy              User?                    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                   @relation("UserReferrals")
  referralClicks          ReferralClick[]
  badges                  UserBadge[]
  favoriteTeam            String?
  referralPoints          Int                      @default(0)
  dailyStreak             Int                      @default(0)
  lastDailyChallengeDate  String?
  footballIq              Int                      @default(100)
  xp                      Int                      @default(0)
  userLevel               Int                      @default(1)
  activityStreak          Int                      @default(0)
  bestActivityStreak      Int                      @default(0)
  lastActivityAt          DateTime?
  ownedLeagues            PrivateLeague[]          @relation("LeagueOwner")
  leagueMemberships       PrivateLeagueMember[]
  dailyEntries            DailyChallengeEntry[]
  notificationPrefs       UserNotificationPrefs?
  missionProgress         UserMissionProgress[]

  @@index([referredById])
  @@index([createdAt])
  @@index([footballIq])
  @@index([xp])
}

model ReferralClick {
  id           String   @id @default(cuid())
  referralCode String
  userId       String?
  ipHash       String?
  userAgent    String?
  registered   Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([referralCode])
  @@index([userId])
  @@index([createdAt])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badge    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
}

model OtpChallenge {
  id             String    @id @default(cuid())
  phone          String
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  usedAt         DateTime?
  customerId     String?
  serverId       String?
  providerStatus String?
  createdAt      DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Match {
  id                     String                 @id @default(cuid())
  homeTeam               String
  awayTeam               String
  homeTeamFa             String
  awayTeamFa             String
  homeTeamAr             String?
  awayTeamAr             String?
  stage                  String
  stageEn                String?
  stageAr                String?
  kickoffAt              DateTime
  homeScore              Int?
  awayScore              Int?
  isFinished             Boolean                @default(false)
  predictionLockOverride String?
  scoreSourceName        String?
  scoreSourceUrl         String?
  scoreVerifiedAt        DateTime?
  externalMatchId        String?
  highlightsUrl          String?
  highlightsProvider     String?
  highlightsEmbedUrl     String?
  aiRefreshedAt          DateTime?
  createdAt              DateTime               @default(now())
  predictions            Prediction[]
  tournamentPredictions  TournamentPrediction[]
  analysis               MatchAnalysis?
  dailyChallenges        DailyChallenge[]
  events                 MatchEvent[]

  @@index([kickoffAt])
  @@index([isFinished])
  @@index([scoreVerifiedAt])
  @@index([externalMatchId])
}

model MatchEvent {
  id            String   @id @default(cuid())
  matchId       String
  minute        Int?
  type          String
  teamName      String?
  playerName    String?
  descriptionFa String?
  descriptionEn String?
  descriptionAr String?
  sourceUrl     String?
  createdAt     DateTime @default(now())
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([matchId, minute])
}

model DailyChallenge {
  id            String                @id @default(cuid())
  matchId       String
  challengeDate String
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  entries       DailyChallengeEntry[]

  @@unique([challengeDate])
  @@index([matchId])
}

model DailyChallengeEntry {
  id            String         @id @default(cuid())
  challengeId   String
  userId        String
  homeScore     Int
  awayScore     Int
  firstGoalTeam String
  winnerPick    String
  points        Int            @default(0)
  createdAt     DateTime       @default(now())
  challenge     DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model UserNotificationPrefs {
  userId            String  @id
  matchReminders    Boolean @default(true)
  leagueUpdates     Boolean @default(true)
  predictionResults Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivateLeague {
  id           String                   @id @default(cuid())
  code         String                   @unique
  title        String
  description  String?
  type         String                   @default("friends")
  privacy      String                   @default("private")
  logoUrl      String?
  schoolName   String?
  schoolGrade  String?
  isActive     Boolean                  @default(true)
  isFeatured   Boolean                  @default(false)
  ownerId      String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @default(now()) @updatedAt
  owner        User                     @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      PrivateLeagueMember[]
  inviteClicks PrivateLeagueInviteClick[]
  trashTalk    LeagueTrashTalk?

  @@index([ownerId])
  @@index([type])
  @@index([isActive])
}

model PrivateLeagueMember {
  id       String        @id @default(cuid())
  leagueId String
  userId   String
  role     String        @default("member")
  joinedAt DateTime      @default(now())
  league   PrivateLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}

model PrivateLeagueInviteClick {
  id         String        @id @default(cuid())
  leagueId   String
  leagueCode String
  userId     String?
  ipHash     String?
  userAgent  String?
  registered Boolean       @default(false)
  joined     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  league     PrivateLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueCode])
  @@index([leagueId])
  @@index([userId])
}

model MatchAnalysis {
  id                 String   @id @default(cuid())
  matchId            String   @unique
  homeWinPct         Int
  drawPct            Int
  awayWinPct         Int
  riskLevel          String
  suggestedHomeScore Int
  suggestedAwayScore Int
  reasoningFa        String
  reasoningEn        String?
  reasoningAr        String?
  isPinned           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model LeagueTrashTalk {
  id        String        @id @default(cuid())
  leagueId  String        @unique
  linesFa   String
  linesEn   String?
  linesAr   String?
  updatedAt DateTime      @default(now()) @updatedAt
  league    PrivateLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model DailyRecap {
  id        String   @id @default(cuid())
  recapDate String   @unique
  dataJson  String
  createdAt DateTime @default(now())
}

model UserMissionProgress {
  id          String   @id @default(cuid())
  userId      String
  missionDate String
  missionKey  String
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionDate, missionKey])
  @@index([userId, missionDate])
}

model UiTranslation {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

model Tournament {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  nameFa        String
  nameEn        String
  nameAr        String
  descriptionFa String?
  descriptionEn String?
  descriptionAr String?
  isVip         Boolean                @default(false)
  isActive      Boolean                @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime               @default(now())
  memberships   TournamentMembership[]
  predictions   TournamentPrediction[]
  prizes        Prize[]
}

model TournamentMembership {
  id           String     @id @default(cuid())
  userId       String
  tournamentId String
  joinedAt     DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

model TournamentPrediction {
  id           String   @id @default(cuid())
  userId       String
  matchId      String
  tournamentId String
  homeScore    Int
  awayScore    Int
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, tournamentId])
  @@index([tournamentId])
}

model AdBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  linkUrl   String?
  placement String
  locale    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Prize {
  id            String      @id @default(cuid())
  tournamentId  String?
  titleFa       String
  titleEn       String
  titleAr       String
  sponsorName   String?
  descriptionFa String?
  descriptionEn String?
  descriptionAr String?
  rankFrom      Int         @default(1)
  rankTo        Int         @default(1)
  isActive      Boolean     @default(true)
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
}

model PaymentSettings {
  id                 String   @id @default("default")
  paymentsEnabled    Boolean  @default(false)
  vipPaymentsEnabled Boolean  @default(false)
  providerName       String   @default("placeholder")
  currency           String   @default("IRR")
  vipPriceLabel      String   @default("VIP League Pass")
  notes              String?
  updatedAt          DateTime @updatedAt
}
